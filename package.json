{
  "name": "growth-insights",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint && vitest run && playwright test",
    "smoke": "vitest run --config vitest.smoke.config.mts",
    "desktop:web": "vite --config desktop/vite.config.ts",
    "desktop:web:build": "vite build --config desktop/vite.config.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:dev-signed": "APPLE_SIGNING_IDENTITY=\"Apple Development\" tauri build --debug --bundles app",
    "desktop:release": "tauri build --bundles app,dmg",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "e2e": "playwright test",
    "e2e:web": "playwright test --project=web",
    "e2e:desktop": "playwright test --project=desktop"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-http": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
