# 32-byte key for encrypting saved credentials at rest. Required in production.
# Generate with: openssl rand -base64 32
GI_ENCRYPTION_KEY=

# Protects the entire web app, including reports. Required for all production use
# and any instance reachable beyond this Mac. Choose a unique, strong password.
GI_BASIC_AUTH=

# Where encrypted connections and the report cache are stored (default: ./.data).
GI_DATA_DIR=
